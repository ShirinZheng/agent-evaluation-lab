{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "plan_id",
    "verdict",
    "requirement_coverage",
    "requirement_results",
    "findings",
    "unsupported_claims",
    "verified_artifacts",
    "blocked_items",
    "next_experiment",
    "completion_allowed"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "audit_id": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "verdict": {
      "type": "string",
      "enum": ["complete", "partial", "failed", "blocked", "insufficient_evidence"]
    },
    "requirement_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "requirement_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "status", "evidence_refs", "reason"],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["verified", "partial", "failed", "blocked", "missing_evidence"]
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "category",
          "requirement_id",
          "evidence_refs",
          "reason",
          "recommended_action"
        ],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": {
            "type": "string",
            "enum": [
              "missing_evidence",
              "contradiction",
              "failed_requirement",
              "invalid_artifact",
              "unsupported_claim",
              "unsafe_action",
              "regression",
              "traceability"
            ]
          },
          "requirement_id": { "type": ["string", "null"] },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 },
          "recommended_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verified_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocked_items": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "next_experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "change", "expected_signal", "stop_condition"],
      "properties": {
        "hypothesis": { "type": "string", "minLength": 1 },
        "change": { "type": "string", "minLength": 1 },
        "expected_signal": { "type": "string", "minLength": 1 },
        "stop_condition": { "type": "string", "minLength": 1 }
      }
    },
    "completion_allowed": { "type": "boolean" }
  }
}
