{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "objective",
    "constraints",
    "non_goals",
    "assumptions",
    "milestones",
    "tasks",
    "checkpoints",
    "recovery_rules",
    "stop_conditions",
    "final_acceptance"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "plan_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/statement" }
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "validation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "validation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "task_ids", "acceptance_criteria"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "depends_on",
          "inputs",
          "outputs",
          "acceptance_criteria",
          "risk_level",
          "authorization_required"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "authorization_required": { "type": "boolean" }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "after_task_ids", "durable_state", "validation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "after_task_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "durable_state": { "type": "string", "minLength": 1 },
          "validation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recovery_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "preserved_state", "next_action", "retry_limit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "preserved_state": { "type": "string", "minLength": 1 },
          "next_action": { "type": "string", "minLength": 1 },
          "retry_limit": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/statement" }
    },
    "final_acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/statement" }
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    }
  }
}
