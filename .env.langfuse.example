# Copy to .env.langfuse.local. These defaults are for localhost evaluation only.
NEXTAUTH_URL=http://localhost:3000
SALT=local-eval-salt-change-me
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXTAUTH_SECRET=local-eval-nextauth-secret-change-me

# Headless bootstrap creates one local project and API key pair.
LANGFUSE_INIT_ORG_ID=local-eval-org
LANGFUSE_INIT_ORG_NAME=Local Evaluation Lab
LANGFUSE_INIT_PROJECT_ID=local-eval-project
LANGFUSE_INIT_PROJECT_NAME=Agent Evaluation Lab
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local
LANGFUSE_INIT_USER_EMAIL=local-admin@example.invalid
LANGFUSE_INIT_USER_NAME=Local Admin
LANGFUSE_INIT_USER_PASSWORD=local-only-change-me-1234
